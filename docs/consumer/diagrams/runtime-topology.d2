vars: {
  d2-config: {
    sketch: true
    theme-id: 4
    layout-engine: dagre
    center: true
    pad: 20
  }
}

direction: right

*.style.font-size: 20
*.style.stroke-width: 2
compose.*.style.font-size: 20
compose.*.style.stroke-width: 2
(** -> **)[*].style.font-size: 18
(** -> **)[*].style.stroke-width: 2

title: "Local Runtime — Everything in Docker Compose" {
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

browser: "Browser" {shape: person}

compose: "Docker Compose network" {
  frontend: "frontend\nnginx · host :4443\nAngular bundle"
  bff: "bff\nSpring Boot · host :8080"
  fineract: "fineract\nFineract Core 1.12.1\nhost :8888"
  bffdb: "bff-db\nPostgreSQL · host :5432" {shape: cylinder}
  fineractdb: "fineract-db\nPostgreSQL · host :5433" {shape: cylinder}
  valkey: "valkey\nValkey 8 · host :6379" {shape: cylinder}
  mailpit: "mailpit\ndev SMTP · UI :8025"
}

browser -> compose.frontend: "HTTPS :4443\napp + /api/*"
compose.frontend -> compose.bff: "proxy /api/*"
compose.bff -> compose.fineract: "Feign\nservice account"
compose.bff -> compose.bffdb: "users · tokens\nconsents · audit"
compose.bff -> compose.valkey: "OTP hashes · denylist\nrate limits · caches"
compose.bff -> compose.mailpit: "OTP\nemails"
compose.fineract -> compose.fineractdb: "tenant\ndatabase" {style.stroke-dash: 3}

note: "frontend runs in the e2e stack only. Backend-only runs hit the BFF directly on localhost:8080." {
  near: bottom-center
  shape: text
  style.font-size: 16
  style.italic: true
}
